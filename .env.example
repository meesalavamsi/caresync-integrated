# ─── ServiceNow PDI (system of record) ───────────────────────────────────────
# No trailing slash. Credentials are used server-side only — never exposed to React.
SERVICENOW_INSTANCE=https://your-instance-id.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your-servicenow-password

# ─── Google Gemini (AI triage, bed prediction, family voice) ─────────────────
# Two keys let you isolate quota between the main features and the voice bot.
# GEMINI_API_KEY is a single-key fallback used if the specific keys are absent.
GEMINI_API_KEY_MAIN=your-gemini-key
GEMINI_API_KEY_VOICE=your-second-gemini-key
GEMINI_API_KEY=
# Model availability changes over time — set this to whatever your Google AI
# Studio account currently exposes (e.g. gemini-2.0-flash, gemini-2.5-flash).
GEMINI_MODEL=gemini-2.0-flash

# ─── Email (OTP, staff-approval links, mismatch escalation) ──────────────────
# EMAIL_PASS must be a Gmail App Password (needs 2FA on that account), NOT the
# normal login password. If left blank, email is skipped and OTP codes are
# returned in the API response (dev mode) so the flow stays testable.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
